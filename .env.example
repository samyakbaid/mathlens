# Copy this file to .env and fill it in.
# PORT=3000

# Which AI answers the "Ask AI" page: anthropic (default) or openai-compatible
AI_PROVIDER=anthropic

# ── Option 1: Claude ─────────────────────────────────────────────
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-key-here
# CLAUDE_MODEL=claude-opus-5-5

# ── Option 2: an open-weight model (set AI_PROVIDER=openai-compatible) ──
# Works with any OpenAI-compatible server. Pick one block:
#
# Ollama on this computer (free; needs a strong machine for good results):
#   ollama pull qwen3-coder:30b
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=qwen3-coder:30b
#
# LM Studio on this computer:
#   AI_BASE_URL=http://localhost:1234/v1
#   AI_MODEL=<model id shown in LM Studio>
#
# OpenRouter (hosted; big open models for a fraction of a cent per answer):
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_API_KEY=sk-or-...
#   AI_MODEL=qwen/qwen3-coder
#
# OpenAI (not open-weight, but cheap small models work well):
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-6-luna
#   AI_REASONING_EFFORT=medium     # none | low | medium | high: lower is cheaper and faster, but low skips some lesson rules
#
# Together / Groq / DeepInfra / Fireworks work the same way: their /v1 URL, key and model id.
#
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_MODEL=
# AI_MAX_TOKENS=16384

# ── Accounts, free limits and credits ─────────────────────────────
# Free use (defaults shown)
# TRIAL_ANSWERS=3                  # AI answers without an account
# FREE_ANSWERS_AFTER_SIGNUP=3      # extra free answers after signing up
# TRIAL_PER_IP_PER_DAY=10          # anti-abuse cap per network
# FREE_SIGNUPS_PER_IP_PER_DAY=3    # new accounts per network per day that get free answers

# Pricing: answers are billed at their real AI cost, converted to ₹, plus a small markup
# that only covers Razorpay's fee. Set the model's price if it isn't built in (see server/billing.js).
# USD_TO_INR=90
# PRICE_MARKUP=0.03
# MIN_TOPUP_RUPEES=10
# MAX_TOPUP_RUPEES=5000
# AI_PRICE_INPUT_PER_M=0.10        # USD per million input tokens
# AI_PRICE_OUTPUT_PER_M=0.50       # USD per million output tokens

# Razorpay (dashboard.razorpay.com → Account & Settings → API Keys; use Test Mode keys first)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...      # optional: Webhooks → add /api/payments/webhook, events payment.captured + order.paid

# Google sign-in (console.cloud.google.com → APIs & Services → Credentials → OAuth client ID → Web application;
# add your site, e.g. http://localhost:3000, under "Authorized JavaScript origins")
# Only the client ID is needed. Don't put the client secret anywhere in MathLens.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# When the site runs on HTTPS behind a proxy (Render, Railway, nginx...):
# COOKIE_SECURE=true
# TRUST_PROXY=1

# ── Business details (shown on /contact, /terms, /privacy, /refunds and on receipts) ──
# Razorpay checks these pages before turning on live payments.
# BUSINESS_NAME=Your full name or registered business name
# SUPPORT_EMAIL=support@yourdomain.com
# BUSINESS_ADDRESS=Street, City, State, PIN code, India
# BUSINESS_PHONE=+91 98765 43210          # optional
# BUSINESS_CITY=Mumbai                     # optional: used for "courts in ..." in the terms
# BUSINESS_GSTIN=                          # optional: receipts become "Tax invoice" when set

# ---- Going live ----------------------------------------------------------------------------
# Set these on your hosting provider, not in a committed file.
# COOKIE_SECURE=true
# TRUST_PROXY=1
# DATA_DIR=/data                   # must be a persistent disk, or accounts and credit are lost on redeploy
# Swap the Razorpay test keys for live keys only after Razorpay approves the site.

# ---- Password reset emails -------------------------------------------------------------------
# Any SMTP provider works. With Gmail: turn on 2-Step Verification, create an app password at
# myaccount.google.com/apppasswords, and use it as SMTP_PASS (never your normal password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# MAIL_FROM=MathLens <you@gmail.com>
# PUBLIC_URL=https://your-domain.com   # needed once deployed: links in emails point here

# ---- Off-server backups ------------------------------------------------------------------------
# Encrypted daily copies pushed to a private repo. Setup and restore steps are in README.md.
# BACKUP_REPO=git@github.com:you/mathlens-backups.git
# BACKUP_AGE_RECIPIENT=age1...      # public key from: age-keygen -y ~/.config/mathlens/backup-key.txt
